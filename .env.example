# ── Supabase ─────────────────────────────────────────────────────────────────
# REQUIRED. Local values come from `npx supabase status`.
# Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED, SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by scripts/ and migration smoke tests.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# ── App ──────────────────────────────────────────────────────────────────────
# REQUIRED. Absolute origin. Embedded in invoice PDFs, email links and the
# customer statement link, so a wrong value ships broken links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
